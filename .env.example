# Copy this file to .env.local (gitignored) and fill it in yourself.
# Shakedown only ever talks to the PayPal SANDBOX. A live environment is refused.

PAYPAL_ENV=sandbox

# Your sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# In local dev, the demo store and Shakedown share this merchant app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Claude, used by the AI layer (Phase 5).
ANTHROPIC_API_KEY=

# Local Postgres from `pnpm db:up` (development defaults, not a secret).
DATABASE_URL=postgres://shakedown:shakedown@localhost:5432/shakedown

# Shared secret for the demo store's read-only probe API (any 16+ char string).
SHAKEDOWN_PROBE_SECRET=

# The demo store's own database. Leave blank to use an in-process Postgres (PGlite) under
# apps/leaky-llama/.data, which needs no Docker. Set it to a postgres:// URL when hosting.
STORE_DATABASE_URL=

# The webhook ID PayPal gave the demo store's listener. Needed for verify-webhook-signature;
# without it, a sealed listener refuses every event (it fails closed).
PAYPAL_WEBHOOK_ID=

# Served at /.well-known/shakedown.txt to prove you own a target (any 16+ char string).
SHAKEDOWN_VERIFICATION_TOKEN=

# Lulu, the demo store's support assistant (Claude). Needs ANTHROPIC_API_KEY above.
# Model defaults to claude-opus-5 and effort to medium. claude-haiku-4-5 is cheaper per turn.
LULU_MODEL=
LULU_EFFORT=

# Where the demo store keeps its in-process database when STORE_DATABASE_URL is blank.
# Each running server needs its own directory. Defaults to .data/pglite.
STORE_DATA_DIR=
