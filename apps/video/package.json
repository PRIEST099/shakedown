{
  "name": "@shakedown/video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Remotion compositions for the Shakedown explainer and demo videos. Reuses @shakedown/ui.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "data": "cd ../web && tsx ../video/scripts/data.ts",
    "capture": "tsx scripts/capture.ts",
    "conform": "tsx scripts/conform.ts",
    "compose": "tsx scripts/compose.ts",
    "voice": "tsx scripts/voice.ts",
    "vo-sheet": "tsx scripts/vo-sheet.ts",
    "animatic": "remotion render src/index.ts Demo out/shakedown-animatic.mp4 && tsx scripts/master.ts out/shakedown-animatic.mp4",
    "teaser": "remotion render src/index.ts Teaser out/shakedown-teaser.mp4 && tsx scripts/master.ts out/shakedown-teaser.mp4",
    "master": "tsx scripts/master.ts",
    "thumbnail": "remotion still src/index.ts Thumbnail out/shakedown-thumbnail.png --scale=2",
    "thumbnail:devpost": "remotion still src/index.ts DevpostThumbnail out/shakedown-devpost-thumbnail.png --scale=2",
    "gallery:shots": "tsx scripts/gallery-shots.ts",
    "gallery": "tsx scripts/gallery.ts",
    "sheet": "tsx scripts/contact-sheet.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cli-output": "tsx scripts/cli-output.ts",
    "walkthrough": "remotion render src/index.ts Walkthrough out/shakedown-walkthrough.mp4 && tsx scripts/master.ts out/shakedown-walkthrough.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@shakedown/core": "workspace:*",
    "@shakedown/tokens": "workspace:*",
    "@shakedown/ui": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@shakedown/paypal": "workspace:*",
    "@shakedown/reporters": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "kokoro-js": "1.2.1",
    "tsx": "4.23.15"
  }
}
