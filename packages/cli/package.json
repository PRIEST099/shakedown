{
  "name": "@shakedown-dev/cli",
  "version": "0.2.1",
  "description": "Customers from hell for your PayPal sandbox checkout. Sandbox only.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PRIEST099/shakedown.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/PRIEST099/shakedown#readme",
  "type": "module",
  "bin": {
    "shakedown": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.dts.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@shakedown/ai": "workspace:*",
    "@shakedown/core": "workspace:*",
    "@shakedown/paypal": "workspace:*",
    "@shakedown/reporters": "workspace:*",
    "tsup": "8.5.1"
  }
}
